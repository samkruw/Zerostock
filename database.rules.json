{
  "rules": {
    ".read": false,
    ".write": false,
    "cartons": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'employee')",
      "$id": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'employee')",
        ".validate": "newData.hasChildren(['article','name','location','stock','warn','min']) && newData.child('article').isString() && newData.child('name').isString() && newData.child('location').isString() && newData.child('stock').isNumber() && newData.child('stock').val() >= 0 && newData.child('warn').isNumber() && newData.child('warn').val() >= 0 && newData.child('min').isNumber() && newData.child('min').val() >= 0 && newData.child('warn').val() >= newData.child('min').val()"
      }
    },
    "instructions": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },
    "movements": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'employee')",
      "$id": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'employee')"
      }
    },
    "customerSummary": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'employee')"
    },
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        ".validate": "newData.hasChildren(['name','role']) && newData.child('name').isString() && (newData.child('role').val() === 'admin' || newData.child('role').val() === 'employee' || newData.child('role').val() === 'customer')"
      }
    }
  }
}